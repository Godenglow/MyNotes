{"anim_count":1,"animations":[{"index":0,"preset_class":1,"preset_id":42,"preset_subtype":0,"seq_type":"STTLTimeNodeType_mainSeq","shape_id":"00041b","trigger_id":"kDefaultTriggerId"}],"page_id":"000023","page_index":26,"shape_count":5,"shapes":[{"font_name":"思源黑体 CN Normal","font_size":20.0,"h":222,"id":"00041b","text":"对象的深克隆\r除了我们之前所讲的深克隆方式（之前的深克隆是重写clone()方法）。使用字节数组流也可以完成对象的深克隆。\r原理是：将要克隆的Java对象写到内存中的字节数组中，再从内存中的字节数组中读取对象，读取到的对象就是一个深克隆。\r目前为止，对象拷贝方式：\r调用Object的clone方法，默认是浅克隆，需要深克隆的话，就需要重写clone方法。\r可以通过序列化和反序列化完成对象的克隆。\r也可以通过ByteArrayInputStream和ByteArrayOutputStream完成深克隆。\r","type":"shape","w":755,"x":88,"y":85},{"children":[{"fill":"ED7D31","font_name":"思源黑体 CN Medium","font_size":16.0,"h":0,"id":"00041c","rot":45.0,"text":"\r","type":"shape","w":0,"x":0,"y":0},{"fill":"01255A","font_name":"思源黑体 CN Medium","font_size":16.0,"h":0,"id":"00041d","rot":45.0,"text":"\r","type":"shape","w":0,"x":0,"y":0},{"font_name":"思源黑体 CN Medium","h":0,"id":"00041e","text":"\r","type":"shape","w":0,"x":0,"y":0}],"h":31,"id":"00041f","type":"group","w":37,"x":39,"y":24},{"fill":"none","font_name":"思源黑体 CN Bold","font_size":24.0,"h":39,"id":"000420","text":"18对象克隆\r\r","type":"shape","w":530,"x":85,"y":22},{"h":74,"id":"000421","img":"pptx:\\ppt\\media\\image3.png/qbb9nm","type":"picture","w":370,"x":696,"y":0},{"h":193,"id":"000422","img":"pptx:\\ppt\\media\\image19.png/qbb9nm","type":"picture","w":314,"x":130,"y":315}],"version":0}
